# ==========================================================================
#  CONFIGURACION DEL SERVIDOR DE RAPISERVICIOS
#  Copiar este archivo con el nombre .env y completar los valores.
#  El archivo .env nunca se publica dentro del repositorio.
# ==========================================================================

PUERTO=3000

# --------------------------------------------------------------------------
# Google AI Studio - capa de interpretacion
# Obtener la clave en https://aistudio.google.com/apikey
# Cuando la clave permanece vacia, opera el clasificador local de respaldo.
# --------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
# Presupuesto de tiempo de la capa de interpretacion, en milisegundos.
# Agotado el presupuesto, clasifica el motor local y el trabajo continua.
GEMINI_LIMITE_MS=8000
# Confianza minima exigida a la clasificacion. Por debajo del umbral, la orden
# se deriva a revision manual del mecanico.
GEMINI_UMBRAL=0.60

# --------------------------------------------------------------------------
# Supabase - base de datos, autenticacion y almacenamiento
# Panel del proyecto > Settings > API
#   SUPABASE_URL            Project URL
#   SUPABASE_CLAVE_ANONIMA  anon public
#   SUPABASE_CLAVE_SERVICIO service_role  (secreta, uso exclusivo del servidor)
# --------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_CLAVE_ANONIMA=
SUPABASE_CLAVE_SERVICIO=
SUPABASE_BUCKET_FOTOGRAFIAS=fotografias-ordenes
